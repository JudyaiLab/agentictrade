[Unit]
Description=AgenticTrade Nanopayments Gateway (x402 on Arc)
After=network.target acf.service

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/agentictrade/nanopayments
EnvironmentFile=/opt/agentictrade/nanopayments/.env
ExecStart=/usr/bin/npx tsx server.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
