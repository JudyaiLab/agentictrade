# Seller: wallet address to receive USDC payments
SELLER_ADDRESS=0xYOUR_WALLET_ADDRESS

# Buyer: private key for signing x402 payment authorizations
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# ACF backend URL
ACF_BACKEND=http://localhost:8092

# Nanopayments gateway port
NANO_PORT=3402

# Accepted networks (comma-separated EIP-155 chain IDs)
# Arc Testnet: eip155:5042002
# Arc Mainnet: eip155:5042001 (when available)
ACCEPTED_NETWORKS=eip155:5042002

# Default price per API call
DEFAULT_PRICE=$0.001
